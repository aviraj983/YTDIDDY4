{
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/blog/how-to-download-youtube-videos-in-4k",
      "destination": "/blog-4k-download.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/((?!api|blog|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
