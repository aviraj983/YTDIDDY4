# Server Port
PORT=3000

# Optional: Cobalt API Instance & API Key
# If you run your own Cobalt instance or use a community instance:
COBALT_API_URL=
COBALT_API_KEY=

# Optional: RapidAPI YouTube Downloader Key
# RapidAPI hub provides various YouTube Downloader APIs with free monthly quotas:
RAPIDAPI_KEY=
RAPIDAPI_HOST=youtube-video-and-audio-downloader-api.p.rapidapi.com
